# Microsoft Fabric Configuration
FABRIC_TENANT_ID=your-tenant-id-here
FABRIC_CLIENT_ID=your-client-id-here
FABRIC_CLIENT_SECRET=your-client-secret-here
FABRIC_WORKSPACE_ID=your-workspace-id-here

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your-account-id
SNOWFLAKE_USER=sync_service
SNOWFLAKE_PASSWORD=your-secure-password
SNOWFLAKE_WAREHOUSE=compute_warehouse
SNOWFLAKE_DATABASE=analytics_db
SNOWFLAKE_SCHEMA=semantic_layer

# Sync Configuration
SYNC_MODE=bidirectional
DRY_RUN=false
LOG_LEVEL=INFO
