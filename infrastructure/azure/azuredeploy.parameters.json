{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "functionAppName": {
            "value": "fabric-snowflake-sync"
        },
        "storageAccountName": {
            "value": "fabricsfsyncstore"
        },
        "redisCacheName": {
            "value": "fabric-sf-sync-cache"
