{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "functionAppName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Azure Function App"
            }
        },
        "storageAccountName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Storage Account"
            }
        },
        "redisCacheName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Azure Cache for Redis"
            }
        },
        "appInsightsName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Application Insights instance"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for all resources"
            }
        },
        "fabricTenantId": {
            "type": "string",
            "metadata": {
                "description": "Microsoft Fabric Tenant ID"
            }
        },
        "fabricClientId": {
            "type": "string",
            "metadata": {
                "description": "Microsoft Fabric Client ID"
            }
        },
        "fabricClientSecret": {
            "type": "securestring",
            "metadata": {
                "description": "Microsoft Fabric Client Secret"
            }
        },
        "fabricWorkspaceId": {
            "type": "string",
            "metadata": {
                "description": "Microsoft Fabric Workspace ID"
            }
        },
        "snowflakeAccount": {
            "type": "string",
            "metadata": {
                "description": "Snowflake Account Identifier"
            }
        },
        "snowflakeUser": {
            "type": "string",
            "metadata": {
                "description": "Snowflake Username"
            }
        },
        "snowflakePassword": {
            "type": "securestring",
            "metadata": {
                "description": "Snowflake Password"
            }
        },
        "snowflakeWarehouse": {
            "type": "string",
            "defaultValue": "SEMANTIC_SYNC_WH",
            "metadata": {
                "description": "Snowflake Warehouse"
            }
        },
        "snowflakeDatabase": {
            "type": "string",
            "defaultValue": "ANALYTICS_DB",
            "metadata": {
                "description": "Snowflake Database"
            }
        },
        "snowflakeSchema": {
            "type": "string",
            "defaultValue": "SEMANTIC_LAYER",
            "metadata": {
                "description": "Snowflake Schema"
            }
        },
        "slackWebhookUrl": {
            "type": "securestring",
            "defaultValue": "",
            "metadata": {
                "description": "Slack Webhook URL for notifications"
            }
        },
        "alertEmailRecipients": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Comma-separated email addresses for alerts"
            }
        }
    },
    "variables": {
        "hostingPlanName": "[concat(parameters('functionAppName'), '-plan')]",
        "syncLogsContainerName": "sync-logs",
        "redisCacheSku": "Basic",
        "redisCacheFamily": "C",
        "redisCacheCapacity": 0
    },
    "resources": [
        {
            "type": "Microsoft.Storage/storageAccounts",
            "apiVersion": "2023-01-01",
            "name": "[parameters('storageAccountName')]",
            "location": "[parameters('location')]",
            "sku": {
                "name": "Standard_LRS"
            },
            "kind": "StorageV2",
            "properties": {
                "supportsHttpsTrafficOnly": true,
                "minimumTlsVersion": "TLS1_2"
            }
        },
        {
            "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
            "apiVersion": "2023-01-01",
            "name": "[concat(parameters('storageAccountName'), '/default/', variables('syncLogsContainerName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
            ],
            "properties": {
                "publicAccess": "None"
            }
        },
        {
            "type": "Microsoft.Cache/redis",
            "apiVersion": "2023-08-01",
            "name": "[parameters('redisCacheName')]",
            "location": "[parameters('location')]",
            "properties": {
                "sku": {
                    "name": "[variables('redisCacheSku')]",
                    "family": "[variables('redisCacheFamily')]",
                    "capacity": "[variables('redisCacheCapacity')]"
                },
                "enableNonSslPort": false,
                "minimumTlsVersion": "1.2",
                "redisConfiguration": {
                    "maxmemory-policy": "volatile-lru"
                }
            }
        },
        {
            "type": "Microsoft.Insights/components",
            "apiVersion": "2020-02-02",
            "name": "[parameters('appInsightsName')]",
            "location": "[parameters('location')]",
            "kind": "web",
            "properties": {
                "Application_Type": "web",
                "Request_Source": "rest"
            }
        },
        {
            "type": "Microsoft.Web/serverfarms",
            "apiVersion": "2022-09-01",
            "name": "[variables('hostingPlanName')]",
            "location": "[parameters('location')]",
            "sku": {
                "name": "Y1",
                "tier": "Dynamic"
            },
            "properties": {
                "reserved": true
            }
        },
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2022-09-01",
            "name": "[parameters('functionAppName')]",
            "location": "[parameters('location')]",
            "kind": "functionapp,linux",
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
                "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]",
                "[resourceId('Microsoft.Cache/redis', parameters('redisCacheName'))]"
            ],
            "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
                "reserved": true,
                "siteConfig": {
                    "linuxFxVersion": "Python|3.11",
                    "appSettings": [
                        {
                            "name": "AzureWebJobsStorage",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-01-01').keys[0].value)]"
                        },
                        {
                            "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-01-01').keys[0].value)]"
                        },
                        {
                            "name": "WEBSITE_CONTENTSHARE",
                            "value": "[toLower(parameters('functionAppName'))]"
                        },
                        {
                            "name": "FUNCTIONS_EXTENSION_VERSION",
                            "value": "~4"
                        },
                        {
                            "name": "FUNCTIONS_WORKER_RUNTIME",
                            "value": "python"
                        },
                        {
                            "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                            "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').InstrumentationKey]"
                        },
                        {
                            "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                            "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
                        },
                        {
                            "name": "FABRIC_TENANT_ID",
                            "value": "[parameters('fabricTenantId')]"
                        },
                        {
                            "name": "FABRIC_CLIENT_ID",
                            "value": "[parameters('fabricClientId')]"
                        },
                        {
                            "name": "FABRIC_CLIENT_SECRET",
                            "value": "[parameters('fabricClientSecret')]"
                        },
                        {
                            "name": "FABRIC_WORKSPACE_ID",
                            "value": "[parameters('fabricWorkspaceId')]"
                        },
                        {
                            "name": "SNOWFLAKE_ACCOUNT",
                            "value": "[parameters('snowflakeAccount')]"
                        },
                        {
                            "name": "SNOWFLAKE_USER",
                            "value": "[parameters('snowflakeUser')]"
                        },
                        {
                            "name": "SNOWFLAKE_PASSWORD",
                            "value": "[parameters('snowflakePassword')]"
                        },
                        {
                            "name": "SNOWFLAKE_WAREHOUSE",
                            "value": "[parameters('snowflakeWarehouse')]"
                        },
                        {
                            "name": "SNOWFLAKE_DATABASE",
                            "value": "[parameters('snowflakeDatabase')]"
                        },
                        {
                            "name": "SNOWFLAKE_SCHEMA",
                            "value": "[parameters('snowflakeSchema')]"
                        },
                        {
                            "name": "REDIS_HOST",
                            "value": "[concat(parameters('redisCacheName'), '.redis.cache.windows.net')]"
                        },
                        {
                            "name": "REDIS_PORT",
                            "value": "6380"
                        },
                        {
                            "name": "REDIS_PASSWORD",
                            "value": "[listKeys(resourceId('Microsoft.Cache/redis', parameters('redisCacheName')), '2023-08-01').primaryKey]"
                        },
                        {
                            "name": "REDIS_SSL",
                            "value": "true"
                        },
                        {
                            "name": "AZURE_STORAGE_CONNECTION_STRING",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-01-01').keys[0].value)]"
                        },
                        {
                            "name": "SYNC_LOGS_CONTAINER",
                            "value": "[variables('syncLogsContainerName')]"
                        },
                        {
                            "name": "SLACK_WEBHOOK_URL",
                            "value": "[parameters('slackWebhookUrl')]"
                        },
                        {
                            "name": "ALERT_EMAIL_RECIPIENTS",
                            "value": "[parameters('alertEmailRecipients')]"
                        },
                        {
                            "name": "SYNC_INTERVAL_HOURS",
                            "value": "1"
                        },
                        {
                            "name": "HEALTH_CHECK_INTERVAL_MINUTES",
                            "value": "15"
                        },
                        {
                            "name": "MAX_RETRY_ATTEMPTS",
                            "value": "3"
                        },
                        {
                            "name": "SYNC_TIMEOUT_MINUTES",
                            "value": "30"
                        }
                    ]
                }
            }
        },
        {
            "type": "microsoft.insights/actionGroups",
            "apiVersion": "2023-01-01",
            "name": "SyncAlertActionGroup",
            "location": "Global",
            "properties": {
                "groupShortName": "SyncAlerts",
                "enabled": true,
                "emailReceivers": [
                    {
                        "name": "DataEngineering",
                        "emailAddress": "[parameters('alertEmailRecipients')]",
                        "useCommonAlertSchema": true
                    }
                ]
            }
        },
        {
            "type": "microsoft.insights/metricAlerts",
            "apiVersion": "2018-03-01",
            "name": "FunctionAppFailureAlert",
            "location": "global",
            "dependsOn": [
                "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]",
                "[resourceId('microsoft.insights/actionGroups', 'SyncAlertActionGroup')]"
            ],
            "properties": {
                "description": "Alert when Function App has execution failures",
                "severity": 1,
                "enabled": true,
                "scopes": [
                    "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT15M",
                "criteria": {
                    "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
                    "allOf": [
                        {
                            "name": "FailedRequests",
                            "metricName": "requests/failed",
                            "operator": "GreaterThan",
                            "threshold": 3,
                            "timeAggregation": "Count"
                        }
                    ]
                },
                "actions": [
                    {
                        "actionGroupId": "[resourceId('microsoft.insights/actionGroups', 'SyncAlertActionGroup')]"
                    }
                ]
            }
        },
        {
            "type": "microsoft.insights/metricAlerts",
            "apiVersion": "2018-03-01",
            "name": "SyncDurationAlert",
            "location": "global",
            "dependsOn": [
                "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]",
                "[resourceId('microsoft.insights/actionGroups', 'SyncAlertActionGroup')]"
            ],
            "properties": {
                "description": "Alert when sync duration exceeds 10 minutes",
                "severity": 2,
                "enabled": true,
                "scopes": [
                    "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT15M",
                "criteria": {
                    "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
                    "allOf": [
                        {
                            "name": "LongDuration",
                            "metricName": "requests/duration",
                            "operator": "GreaterThan",
                            "threshold": 600000,
                            "timeAggregation": "Maximum"
                        }
                    ]
                },
                "actions": [
                    {
                        "actionGroupId": "[resourceId('microsoft.insights/actionGroups', 'SyncAlertActionGroup')]"
                    }
                ]
            }
        }
    ],
    "outputs": {
        "functionAppUrl": {
            "type": "string",
            "value": "[concat('https://', parameters('functionAppName'), '.azurewebsites.net')]"
        },
        "functionAppPrincipalId": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2022-09-01', 'full').identity.principalId]"
        },
        "redisHostName": {
            "type": "string",
            "value": "[concat(parameters('redisCacheName'), '.redis.cache.windows.net')]"
        },
        "appInsightsInstrumentationKey": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').InstrumentationKey]"
        },
        "storageAccountName": {
            "type": "string",
            "value": "[parameters('storageAccountName')]"
        }
    }
}